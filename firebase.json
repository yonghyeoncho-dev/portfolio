{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      ".git/**",
      "**/node_modules/**",
      "**/original_backup/**",
      "**/trimmed_backup/**",
      "**/trimmed/**",
      "**/logos_ready/**",
      "**/*.py",
      "**/*.log",
      "tools/**",
      "README.md",
      "CLAUDE.md",
      "**/*.bak_*",
      "assets/img/shot_*.png",
      "assets/img/banner-*.jpg",
      "firebase-debug.log",
      "*.log"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
      }
    ]
  }
}